@model CineTix.Models.Seat

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Seat</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="ShowtimeId" class="form-label">Suất chiếu</label>
                <select asp-for="ShowtimeId" asp-items="ViewBag.ShowtimeId" class="form-select">
                    <option value="">-- Chọn suất chiếu --</option>
                </select>
                <span asp-validation-for="ShowtimeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SeatCode" class="control-label"></label>
                <input asp-for="SeatCode" class="form-control" />
                <span asp-validation-for="SeatCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SeatType" class="control-label"></label>
                <input asp-for="SeatType" class="form-control" />
                <span asp-validation-for="SeatType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsBooked" class="control-label"></label>
                <input asp-for="IsBooked" class="form-check-input" />
                <span asp-validation-for="IsBooked" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
